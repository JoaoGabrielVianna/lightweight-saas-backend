      "path": "/v1/workspaces/:workspace_id/users/:user_id",
      "scope": "users:read",
      "status": "supported",
      "sdk": "UsersService.Get"
    },
    {
      "method": "PATCH",
      "path": "/v1/workspaces/:workspace_id/users/:user_id",
      "scope": "users:write",
      "status": "supported",
      "sdk": "UsersService.Update"
    },
    {
      "method": "DELETE",
      "path": "/v1/workspaces/:workspace_id/users/:user_id",
      "scope": "users:write",
